---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import { SITE, SOCIALS } from '../consts';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const latest = posts.slice(0, 5);
---

<Base>
  <section class="hero shell fade-up">
    <p class="rail rail--accent">// Full-stack engineer · Nigeria</p>
    <h1>
      I build API platforms, automation pipelines, and AI systems —
      and I write about how they actually get made.
    </h1>
    <p class="intro">
      I'm {SITE.author}. This is where I think out loud about the engineering
      behind real production systems, plus the occasional detour into language
      and faith. No polish for its own sake — just the work, documented.
    </p>
    <div class="cta">
      <a href="/blog" class="btn">Read the writing</a>
      <div class="socials">
        {SOCIALS.map((s) => (
          <a href={s.href} target="_blank" rel="me noopener">{s.label}</a>
        ))}
      </div>
    </div>
  </section>

  <section class="latest shell">
    <div class="section-head">
      <h2>Latest</h2>
      <a href="/blog" class="rail">// full index →</a>
    </div>
    {latest.length === 0 ? (
      <p class="empty">No posts yet. Drop a Markdown file in
        <code>src/content/blog</code> to publish your first one.</p>
    ) : (
      <div class="list">
        {latest.map((post, i) => (
          <PostCard
            href={`/blog/${post.id}/`}
            title={post.data.title}
            description={post.data.description}
            pubDate={post.data.pubDate}
            tags={post.data.tags}
            index={i}
          />
        ))}
      </div>
    )}
  </section>
</Base>

<style>
  .hero {
    padding-block: 4.5rem 3rem;
    max-width: 52rem;
  }
  .hero h1 {
    font-size: clamp(2.1rem, 5.5vw, 3.35rem);
    margin: 1rem 0 1.5rem;
    max-width: 20ch;
  }
  .intro {
    font-size: 1.15rem;
    color: var(--ink-soft);
    max-width: 56ch;
    margin: 0 0 2rem;
  }
  .cta {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    flex-wrap: wrap;
  }
  .btn {
    display: inline-block;
    background: var(--ink);
    color: var(--paper);
    font-weight: 500;
    padding: 0.7rem 1.4rem;
    border-radius: 6px;
    transition: transform 0.15s ease, background 0.15s ease;
  }
  .btn:hover {
    text-decoration: none;
    transform: translateY(-1px);
    background: var(--accent);
  }
  .socials {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    font-size: 0.92rem;
  }
  .socials a {
    color: var(--muted);
  }
  .socials a:hover {
    color: var(--accent);
  }
  .latest {
    padding-block: 1rem 2rem;
  }
  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.5rem;
  }
  .section-head h2 {
    font-size: 1.5rem;
  }
  .section-head a {
    color: var(--muted);
  }
  .list {
    border-bottom: 1px solid var(--line);
  }
  .empty {
    color: var(--muted);
    padding: 2rem 0;
    border-top: 1px solid var(--line);
  }
  .empty code {
    font-family: var(--font-mono);
    font-size: 0.85em;
    background: var(--code-bg);
    padding: 0.1em 0.4em;
    border-radius: 4px;
  }
</style>
