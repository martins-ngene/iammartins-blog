---
import Base from '../layouts/Base.astro';
import { SITE, SOCIALS } from '../consts';
---

<Base title="About" description={`About ${SITE.author}.`}>
  <section class="shell fade-up">
    <p class="rail rail--accent">// About</p>
    <h1>{SITE.author}</h1>

    <div class="prose bio">
      <p>
        I'm a full-stack software engineer based in Nigeria with a bias toward
        systems that run themselves. Day to day I build API platforms,
        automation pipelines, AI integrations, and the DevOps that holds them
        together.
      </p>
      <p>
        This blog is my working notebook — write-ups of the systems I ship, the
        trade-offs behind them, and what I'd do differently next time. Expect
        engineering to dominate, with detours into biblical language study and
        whatever else I'm learning.
      </p>
      <p>
        If something here is useful, wrong, or worth arguing about, I'd like to
        hear it.
      </p>
      <h2>Elsewhere</h2>
      <ul>
        {SOCIALS.map((s) => (
          <li><a href={s.href} target="_blank" rel="me noopener">{s.label}</a></li>
        ))}
        <li><a href={`mailto:${SITE.email}`}>Email</a></li>
      </ul>
    </div>
  </section>
</Base>

<style>
  section {
    padding-block: 3.5rem 2rem;
    max-width: 46rem;
  }
  h1 {
    font-size: clamp(2.2rem, 5vw, 3rem);
    margin: 0.6rem 0 1.75rem;
  }
  .bio h2 {
    font-size: 1.35rem;
    margin-top: 2.5rem;
  }
</style>
