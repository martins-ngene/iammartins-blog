---
import { SITE, NAV } from '../consts';
const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);
---

<header class="site-header">
  <div class="shell inner">
    <a href="/" class="wordmark" aria-label={`${SITE.title} — home`}>
      <span class="mark rail rail--accent">MN</span>
      <span class="name">{SITE.title}</span>
    </a>
    <nav aria-label="Primary">
      <ul>
        {NAV.map((item) => (
          <li>
            <a
              href={item.href}
              class:list={['nav-link', { active: isActive(item.href) }]}
              aria-current={isActive(item.href) ? 'page' : undefined}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--line);
    position: sticky;
    top: 0;
    background: color-mix(in srgb, var(--paper) 88%, transparent);
    backdrop-filter: blur(8px);
    z-index: 50;
  }
  .inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    height: 4.25rem;
  }
  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--ink);
  }
  .wordmark:hover {
    text-decoration: none;
  }
  .mark {
    border: 1.5px solid var(--accent);
    border-radius: 5px;
    padding: 0.2rem 0.35rem;
    line-height: 1;
  }
  .name {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 560;
    letter-spacing: -0.01em;
  }
  nav ul {
    display: flex;
    align-items: center;
    gap: 1.4rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav-link {
    color: var(--ink-soft);
    font-size: 0.95rem;
    font-weight: 500;
  }
  .nav-link:hover {
    color: var(--accent);
    text-decoration: none;
  }
  .nav-link.active {
    color: var(--ink);
  }
  .nav-link.active::after {
    content: '';
    display: block;
    height: 2px;
    background: var(--accent);
    border-radius: 2px;
    margin-top: 2px;
  }
  @media (max-width: 34rem) {
    .name {
      display: none;
    }
    nav ul {
      gap: 1rem;
    }
  }
</style>
