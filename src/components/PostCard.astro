---
import FormattedDate from './FormattedDate.astro';

interface Props {
  href: string;
  title: string;
  description: string;
  pubDate: Date;
  tags: string[];
  index?: number;
}
const { href, title, description, pubDate, tags, index } = Astro.props;
const num = typeof index === 'number' ? String(index + 1).padStart(2, '0') : null;
---

<article class="card">
  <div class="meta">
    {num && <span class="rail num">{num}</span>}
    <span class="rail"><FormattedDate date={pubDate} mono /></span>
  </div>
  <div class="body">
    <h3><a href={href}>{title}</a></h3>
    <p class="desc">{description}</p>
    {tags.length > 0 && (
      <div class="tags">
        {tags.map((t) => (
          <a class="tag-chip" href={`/tags/${t}`}>{t}</a>
        ))}
      </div>
    )}
  </div>
</article>

<style>
  .card {
    display: grid;
    grid-template-columns: 9rem 1fr;
    gap: 1.5rem;
    padding: 1.75rem 0;
    border-top: 1px solid var(--line);
  }
  .meta {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding-top: 0.4rem;
  }
  .num {
    color: var(--accent);
    font-size: 0.8rem;
  }
  h3 {
    font-size: 1.4rem;
    margin: 0 0 0.4rem;
  }
  h3 a {
    color: var(--ink);
  }
  h3 a:hover {
    color: var(--accent);
    text-decoration: none;
  }
  .desc {
    color: var(--muted);
    margin: 0 0 0.85rem;
    max-width: 60ch;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  @media (max-width: 40rem) {
    .card {
      grid-template-columns: 1fr;
      gap: 0.6rem;
    }
    .meta {
      flex-direction: row;
      gap: 0.9rem;
      padding-top: 0;
    }
  }
</style>
